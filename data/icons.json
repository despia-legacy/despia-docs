{
  "_note": "THE ICON OF EVERY PAGE, SECTION AND CARD, declared once (owner 2026-10-08: no page without an icon). SF Symbol names from the set the DSX runtime ships on every platform (OpenSource/Conformance/icons/sf-map.json). A page resolves its icon in this order: its own front matter `icon:` (an SF name, or a Mintlify FontAwesome name, mapped), `routes` (exact), the first `rules` row whose `match` (a regular expression, case-insensitive) matches the route or the title, its section's icon, then `fallback`. compile.mjs reads this file and reports every page that lands on the fallback.",
  "fallback": "doc.text",
  "sections": {
    "Start": "house",
    "Guides": "book",
    "Services": "server.rack",
    "Modules": "shippingbox",
    "Components": "square.grid.2x2",
    "Styling": "paintbrush",
    "Skills": "hammer",
    "Move to v4": "arrow.down.doc",
    "Migration": "arrow.down.doc",
    "Troubleshooting": "ladybug",
    "Releases": "newspaper",
    "App Review": "checkmark.seal"
  },
  "routes": {
    "/": "house",
    "/quickstart": "bolt",
    "/agents": "sparkles",
    "/system": "paintpalette",
    "/writing-docs": "pencil",
    "/migrate": "arrow.down.doc",
    "/migrate/guide": "list.bullet",
    "/migrate/map": "map",
    "/troubleshooting": "list.bullet",
    "/releases": "newspaper",
    "/app-review": "list.bullet",
    "/framework/modules": "shippingbox",
    "/framework/guides/build-a-module": "hammer",
    "/guides/web-app-with-native-screens": "iphone",
    "/guides/native-app-with-web-views": "globe",
    "/services/on-its-own": "bell",
    "/services/connecting": "link",
    "/components": "square.grid.2x2"
  },
  "rules": [
    { "match": "biometric|passkey|faceid|face id", "icon": "faceid" },
    { "match": "deprecat", "icon": "exclamationmark.triangle" },
    { "match": "secret|credential|signing|provision|keychain|vault", "icon": "key" },
    { "match": "auth|login|sign in|session|identity|oauth", "icon": "person.crop.circle" },
    { "match": "push|notif|messag", "icon": "bell" },
    { "match": "purchase|payment|paywall|revenuecat|commerce|billing|subscription|stripe|polar", "icon": "creditcard" },
    { "match": "camera|photo|image|media|video|gallery", "icon": "camera" },
    { "match": "audio|sound|mic|voice|speech", "icon": "mic" },
    { "match": "location|geo|map", "icon": "location" },
    { "match": "contact", "icon": "person.2" },
    { "match": "file|storage|database|sqlite|postgres|clickhouse|sync|offline|cache", "icon": "externaldrive" },
    { "match": "network|http|api|fetch|websocket|relay|transport", "icon": "network" },
    { "match": "deploy|ota|release|publish|ship|codemagic|build", "icon": "paperplane" },
    { "match": "test|debug|doctor|lint|qa|inspect", "icon": "ladybug" },
    { "match": "cli|command|terminal|mcp", "icon": "terminal" },
    { "match": "agent|ai|llm|skill", "icon": "sparkles" },
    { "match": "style|css|theme|color|font|typograph|motion|animation|transition|layout|adaptive|design", "icon": "paintbrush" },
    { "match": "route|routing|navigation|link|deep", "icon": "signpost.right" },
    { "match": "state|event|context|data|variable|action", "icon": "arrow.left.arrow.right" },
    { "match": "module|package|extension|plugin|integration", "icon": "shippingbox" },
    { "match": "android|google play|play store", "icon": "iphone" },
    { "match": "ios|iphone|ipad|apple|app store|testflight|xcode", "icon": "apple.logo" },
    { "match": "web|browser|pwa|webview|ssr", "icon": "globe" },
    { "match": "widget|live activit|watch|tv", "icon": "square.grid.2x2" },
    { "match": "permission|privacy|consent|security|integrity", "icon": "lock.shield" },
    { "match": "markdown|doc|guide|write", "icon": "doc.text" },
    { "match": "combination|matrix|c[0-9]", "icon": "square.grid.2x2" },
    { "match": "quickstart|getting started|start|install|setup|introduction", "icon": "bolt" },
    { "match": "server|backend|service|gateway", "icon": "server.rack" },
    { "match": "platform|support|parity", "icon": "checkmark.seal" },
    { "match": "rejection|review|guideline", "icon": "checkmark.seal" },
    { "match": "changelog|what.s new|improvement", "icon": "newspaper" }
  ]
}
