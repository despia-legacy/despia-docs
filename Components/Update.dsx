<hstack class="doc-update" role="article">
  <head>
    <!-- One changelog entry: the date label on a sticky left rail, the summary line and the
         body slot on the right (one column under 40rem). -->
    <attribute as="label" default="''"/>
    <attribute as="description" default="''"/>
  </head>
  <stack class="doc-update-rail">
    <text value="{{ dsx.attribute.label }}" class="doc-update-label"/>
  </stack>
  <stack class="doc-update-content">
    <text value="{{ dsx.attribute.description }}" class="doc-update-description" visible-if="dsx.attribute.description !== ''"/>
    <slot/>
  </stack>
</hstack>
