<Card title="{{ dsx.attribute.title }}" href="{{ dsx.attribute.href }}" class="doc-fixed">
  <head>
    <!--
      The "Fixed fast" card: the stock Card with a user-reported issue, when it was reported
      and when the fix was released, and the time between. The times are computed at build time
      from the article's front matter (reportedAt, fixedAt, releasedAt) by scripts/compile.mjs,
      so every reader sees the same UTC values; nothing here is estimated.
    -->
    <attribute as="title" default="''"/>
    <attribute as="href" default="''"/>
    <attribute as="reported" default="''"/>
    <attribute as="released" default="''"/>
    <attribute as="duration" default="''"/>
    <attribute as="platform" default="''"/>
  </head>
  <hstack class="doc-fixed-top">
    <text value="{{ dsx.attribute.duration }}" type="title2"/>
    <chip label="{{ dsx.attribute.platform }}" visible-if="dsx.attribute.platform !== ''"/>
  </hstack>
  <text value="{{ 'Reported ' + dsx.attribute.reported + ' · fixed and released ' + dsx.attribute.released }}" type="footnote"/>
</Card>
