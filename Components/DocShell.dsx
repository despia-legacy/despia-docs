<!-- DocShell: the docs' one frame (owner 2026-10-10: the console's parts, the density and layout of the best docs sites).
     A <scaffold shell="automatic"> holds the stock SidebarList (space + version and search pinned on top, the generated
     DocNav sections, Appearance at the foot) and the page. The page releases the system route bar (a docs page is never
     "Back" to anything) and draws its own header: on a phone a top bar (logo, search, menu opening the sidebar as a sheet),
     on every width the article header (section, title, description, page actions). The article is one reading column
     (~760px) beside a sticky "On this page" rail on wide windows. Look: Components/DocShell.css (the docs design layer).
     <DocShell title="…" description="…" route="/x" space="modern" md="/x.md" toc="[…]" …> …page content… </DocShell> -->
<scaffold shell="automatic" sidebarLabel="Despia docs" contentLabel="Page" collapse="content" sidebarIdeal="260" sidebarMin="240" sidebarMax="300"
          class="doc-shell" on:appear="dsx.module.route.chrome({ show: 'false' })">
  <head>
    <attribute as="title" default="'Despia docs'"/>
    <attribute as="label" default="''"/>
    <attribute as="description" default="''"/>
    <attribute as="route" default="'/'"/>
    <attribute as="space" default="'modern'"/>
    <!-- the spaces (id, label, home) as JSON: scripts/compile.mjs SPACES is the one declaration -->
    <attribute as="spaces" default="'[]'"/>
    <!-- the page's markdown twin (route + .md) -->
    <attribute as="md" default="''"/>
    <attribute as="section" default="''"/>
    <attribute as="toc" default="'[]'"/>
    <attribute as="prev" default="''"/>
    <attribute as="prevLabel" default="''"/>
    <attribute as="next" default="''"/>
    <attribute as="nextLabel" default="''"/>
    <!-- Legacy pages: the Despia V4 equivalent when the migration map knows one -->
    <attribute as="modern" default="''"/>
    <!-- the release these docs describe (data/release.json) -->
    <attribute as="version" default="''"/>
    <attribute as="supportOrigin" default="'https://support.despia.com'"/>
    <attribute as="stability" default="'stable'"/>
    <attribute as="since" default="''"/>
    <attribute as="changed" default="''"/>
    <attribute as="removed" default="''"/>
    <attribute as="improved" default="'[]'"/>

    <variable as="query">return ''</variable>
    <variable as="navOpen">return false</variable>
    <variable as="askOpen">return false</variable>
    <variable as="askQ">return ''</variable>
    <api as="searchIndex" url="/search-index.json"/>
    <variable as="compact" computed="true">return dsx.screen.width &lt; 760</variable>

    <formula as="spaceList" input:raw="dsx.attribute.spaces">return raw ? JSON.parse(raw) : []</formula>
    <formula as="spaceLabel" input:space="dsx.attribute.space" input:list="dsx.formula.spaceList">
      const hit = list.find((s) => s.id === space)
      return hit ? hit.label : 'Despia docs'
    </formula>
    <!-- the space switcher, the console's workspace menu: one row per space, the current one checked -->
    <formula as="spaceMenu" input:space="dsx.attribute.space" input:list="dsx.formula.spaceList">
      return [{ header: true, title: 'Documentation' }].concat(list.map((s) => ({
        title: s.label, icon: s.id === space ? 'checkmark' : 'book', href: s.home
      })))
    </formula>
    <formula as="appearanceMenu">
      return [
        { header: true, title: 'Appearance' },
        { title: 'System', icon: 'circle.lefthalf.filled', action: 'appearance.set', args: { mode: 'system' } },
        { title: 'Light', icon: 'sun.max', action: 'appearance.set', args: { mode: 'light' } },
        { title: 'Dark', icon: 'moon', action: 'appearance.set', args: { mode: 'dark' } }
      ]
    </formula>
    <!-- search: the build-time index, titles first, then text; this space only -->
    <formula as="hitRows" input:q="dsx.variable.query" input:space="dsx.attribute.space">
      if (!q || q.length &lt; 2) { return [] }
      const index = dsx.api.searchIndex.data
      if (!index || !index.pages) { return [] }
      const needle = q.toLowerCase()
      const pool = index.pages.filter((page) => page.space === space)
      const inTitle = pool.filter((page) => page.title.toLowerCase().includes(needle))
      const inText = pool.filter((page) => !page.title.toLowerCase().includes(needle) &amp;&amp; page.text.toLowerCase().includes(needle))
      return inTitle.concat(inText).slice(0, 12).map((page) => ({ id: page.route, route: page.route, title: page.label ? page.label : page.title }))
    </formula>
    <formula as="tocRows" input:raw="dsx.attribute.toc">return raw ? JSON.parse(raw).filter((t) => t.level === 2 || t.level === 3) : []</formula>
    <!-- the page menu (the console's "…" menu shape): every row carries a symbol -->
    <formula as="pageMenu" input:md="dsx.attribute.md">
      const ask = encodeURIComponent('Read https://docs.despia.com' + md + ' so I can ask questions about it.')
      return [
        { header: true, title: 'This page' },
        { title: 'View as Markdown', icon: 'doc.plaintext', href: md },
        { separator: true },
        { header: true, title: 'Open in' },
        { title: 'Claude', icon: 'sparkles', href: 'https://claude.ai/new?q=' + ask },
        { title: 'ChatGPT', icon: 'bubble.left', href: 'https://chatgpt.com/?hints=search&amp;q=' + ask },
        { title: 'Your editor (MCP)', icon: 'terminal', href: '/agents' }
      ]
    </formula>
    <action as="open" input:path="dsx.this.value">
      dsx.variable.navOpen = false
      dsx.module.route.select({ path: path })
    </action>
  </head>

  <SidebarList pane="sidebar" value="{{ dsx.attribute.route }}" a11yLabel="Documentation" on:change="dsx.action.open()">
    <menu slot="top" menu="{{ dsx.formula.spaceMenu }}">
      <SettingsRow icon="despia.logo.mono" iconStyle="plain" title="{{ dsx.formula.spaceLabel }}" subtitle="{{ dsx.attribute.version }}"
                   valueIcon="chevron.up.chevron.down" tappable="true"/>
    </menu>
    <searchbar slot="top" bind="dsx.variable.query" placeholder="Search docs"/>
    <SidebarSection title="Results" visible-if="dsx.variable.query.length &gt;= 2">
      <SidebarItem repeat="dsx.formula.hitRows" key="id" value="{{ dsx.this.route }}" title="{{ dsx.this.title }}"/>
    </SidebarSection>
    <DocNav route="{{ dsx.attribute.route }}" space="{{ dsx.attribute.space }}" visible-if="dsx.variable.query.length &lt; 2"/>
    <menu slot="bottom" menu="{{ dsx.formula.appearanceMenu }}">
      <SettingsRow icon="circle.lefthalf.filled" title="Appearance" valueIcon="chevron.up.chevron.down" tappable="true"/>
    </menu>
  </SidebarList>

  <scroll pane="content" class="doc-content">
    <!-- the phone's top bar: the mark, search and the menu that opens the navigation -->
    <hstack class="doc-topbar" visible-if="dsx.variable.compact" role="banner">
      <pressable href="/" a11yLabel="Despia docs home" class="doc-topbar-home">
        <image icon="despia.logo.mono" a11yHidden="true"/>
        <text value="Despia docs" type="headline"/>
      </pressable>
      <spacer/>
      <button icon="magnifyingglass" variant="plain" a11yLabel="Search the docs" on:tap="dsx.variable.navOpen = true"/>
      <button icon="line.3.horizontal" variant="plain" a11yLabel="Open the navigation" on:tap="dsx.variable.navOpen = true"/>
    </hstack>

    <hstack class="doc-layout">
      <vstack class="doc-article">
        <!-- the article header: where the page sits, the page actions, the title and its one sentence -->
        <hstack class="doc-article-bar">
          <text class="doc-eyebrow" value="{{ dsx.attribute.section }}" type="footnote"/>
          <spacer/>
          <hstack class="doc-actions" role="toolbar" a11yLabel="Page actions" visible-if="dsx.attribute.md !== ''">
            <button label="Copy page" icon="doc.on.doc" variant="bordered" controlSize="small" class="doc-actions-copy" a11yLabel="Copy this page as Markdown"/>
            <menu menu="{{ dsx.formula.pageMenu }}">
              <button icon="chevron.down" variant="bordered" controlSize="small" a11yLabel="More ways to use this page"/>
            </menu>
            <button icon="sparkles" label="Ask AI" variant="bordered" controlSize="small" on:tap="dsx.variable.askOpen = true"/>
          </hstack>
        </hstack>
        <text class="doc-title" value="{{ dsx.attribute.title }}" type="title1" a11yTrait="header"/>
        <text class="doc-description" value="{{ dsx.attribute.description }}" type="body" visible-if="dsx.attribute.description !== ''"/>

        <Callout tone="info" title="Legacy (V3)" message="This page documents Despia V3 and the despia-native package."
                 action="{{ dsx.attribute.modern !== '' ? 'Despia V4 equivalent' : 'Migration map' }}"
                 visible-if="dsx.attribute.space === 'legacy'"
                 on:action="dsx.module.route.select({ path: dsx.attribute.modern !== '' ? dsx.attribute.modern : '/migrate/map' })"/>

        <vstack class="doc-page">
          <slot/>
        </vstack>

        <hstack class="doc-pager" visible-if="dsx.attribute.prev !== '' || dsx.attribute.next !== ''">
          <LinkCard title="{{ dsx.attribute.prevLabel }}" description="Previous" href="{{ dsx.attribute.prev }}" visible-if="dsx.attribute.prev !== ''"/>
          <LinkCard title="{{ dsx.attribute.nextLabel }}" description="Next" href="{{ dsx.attribute.next }}" visible-if="dsx.attribute.next !== ''"/>
        </hstack>
      </vstack>

      <vstack class="doc-rail" visible-if="dsx.formula.tocRows.length &gt;= 2" role="navigation" a11yLabel="On this page">
        <text value="On this page" type="footnote" class="doc-rail-title"/>
        <pressable repeat="dsx.formula.tocRows" key="id" href="{{ '#' + dsx.this.id }}" class="{{ 'doc-rail-row doc-rail-level-' + dsx.this.level }}">
          <text value="{{ dsx.this.title }}" type="footnote" lineLimit="2"/>
        </pressable>
      </vstack>
    </hstack>
  </scroll>

  <!-- the navigation as a sheet on a phone (the same sidebar) -->
  <sheet present="dsx.variable.navOpen" detents="full" title="Despia docs" close="trailing" on:dismiss="dsx.variable.navOpen = false">
    <SidebarList value="{{ dsx.attribute.route }}" a11yLabel="Documentation" on:change="dsx.action.open()">
      <searchbar slot="top" bind="dsx.variable.query" placeholder="Search docs"/>
      <SidebarSection title="Results" visible-if="dsx.variable.query.length &gt;= 2">
        <SidebarItem repeat="dsx.formula.hitRows" key="id" value="{{ dsx.this.route }}" title="{{ dsx.this.title }}"/>
      </SidebarSection>
      <DocNav route="{{ dsx.attribute.route }}" space="{{ dsx.attribute.space }}" visible-if="dsx.variable.query.length &lt; 2"/>
    </SidebarList>
  </sheet>

  <sheet present="dsx.variable.askOpen" detents="full" title="Ask AI" close="trailing" on:dismiss="dsx.variable.askOpen = false">
    <DocAsk asked="{{ dsx.variable.askQ }}" sources="[]" on:ask="dsx.variable.askQ = dsx.this.value"/>
  </sheet>
</scaffold>
