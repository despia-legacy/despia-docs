<stack class="doc-root doc-space-{{ dsx.attribute.space }}" style="gap: 0; min-height: 100vh; background: var(--dsx-background); align-items: stretch">
  <head>
    <!--
      The one layout every documentation page mounts, across the four spaces of one site:
      Modern (/), Legacy v3 (/legacy), Migration (/migrate), Troubleshooting
      (/troubleshooting) and App Review (/app-review). A sticky translucent header (wordmark, the space switcher, client
      search over the build-time index scoped to this space or all of them, merged with the
      Support knowledge API's vector hits when they arrive, Ask AI, GitHub, the three-state
      scheme toggle), the space's own sidebar (DocNav, generated by scripts/compile.mjs) as a
      pinned aside on wide frames and the system Drawer under 69rem, a measured content
      column with breadcrumb, page actions (copy as markdown, open in Claude / ChatGPT /
      Cursor), the quiet Legacy banner, prev/next pager cards and the "On this page" rail.
      Layout chrome lives in the DocShell.css sidecar, tokens only.
    -->
    <attribute as="title" default="'Despia docs'"/>
    <attribute as="label" default="''"/>
    <attribute as="route" default="'/'"/>
    <attribute as="space" default="'modern'"/>
    <!-- md = the raw-markdown sibling (route + .md). -->
    <attribute as="md" default="''"/>
    <attribute as="section" default="''"/>
    <attribute as="toc" default="'[]'"/>
    <attribute as="prev" default="''"/>
    <attribute as="prevLabel" default="''"/>
    <attribute as="next" default="''"/>
    <attribute as="nextLabel" default="''"/>
    <!-- Legacy pages: the modern equivalent's route when the migration map knows one. -->
    <attribute as="modern" default="''"/>
    <!-- Versioned docs: the version this build documents, and the page's own lifecycle. -->
    <attribute as="version" default="'0.1.0'"/>
    <attribute as="since" default="''"/>
    <attribute as="changed" default="''"/>
    <attribute as="removed" default="''"/>
    <!-- "Improved in vX" markers from the Improvements ledger (JSON list, compile-time). -->
    <attribute as="improved" default="'[]'"/>
    <!-- The Support knowledge API (vector search). Empty = keyword search only. -->
    <attribute as="supportOrigin" default="'https://support.despia.com'"/>
    <variable as="query">return ''</variable>
    <variable as="navOpen">return false</variable>
    <variable as="searchOpen">return false</variable>
    <variable as="searchFocus">return false</variable>
    <variable as="switcherOpen">return false</variable>
    <variable as="actionsOpen">return false</variable>
    <variable as="scope">return 'This space'</variable>
    <variable as="vector">return []</variable>
    <api as="searchIndex" url="/search-index.json"/>
    <formula as="spaceLabel" input:space="dsx.attribute.space">
      if (space === 'legacy') { return 'Legacy v3' }
      if (space === 'migrate') { return 'Migration' }
      if (space === 'troubleshooting') { return 'Troubleshooting' }
      if (space === 'app-review') { return 'App Review' }
      if (space === 'releases') { return 'Releases' }
      return 'Modern'
    </formula>
    <formula as="spaceHome" input:space="dsx.attribute.space">
      if (space === 'legacy') { return '/legacy/introduction' }
      if (space === 'migrate') { return '/migrate' }
      if (space === 'troubleshooting') { return '/troubleshooting' }
      if (space === 'app-review') { return '/app-review' }
      if (space === 'releases') { return '/releases' }
      return '/'
    </formula>
    <formula as="spaceRows" input:space="dsx.attribute.space">
      return [
        { id: 'modern', label: 'Modern', home: '/', blurb: 'Despia v4 and DSX: one document, native iOS, Android, web and backend' },
        { id: 'legacy', label: 'Legacy v3', home: '/legacy/introduction', blurb: 'despia-native and the v3 runtime, as it shipped' },
        { id: 'migrate', label: 'Migration', home: '/migrate', blurb: 'Move a v3 app to v4, with the feature map' },
        { id: 'troubleshooting', label: 'Troubleshooting', home: '/troubleshooting', blurb: 'Symptom, cause and fix, for v4 and v3' },
        { id: 'releases', label: 'Releases', home: '/releases', blurb: 'Release notes per DSX release and package version' },
        { id: 'app-review', label: 'App Review', home: '/app-review', blurb: 'Apple and Google guidelines, and how to pass them' },
      ].map((row) => ({ id: row.id, label: row.label, home: row.home, blurb: row.blurb, current: row.id === space }))
    </formula>
    <!-- Ranked hits folded into groups: keyword matches first (title, then body), scoped to
         this space unless the scope is "All spaces"; then the vector hits the keyword pass
         did not already find, under "Related". Groups keep relevance order. -->
    <formula as="hitGroups" input:q="dsx.variable.query" input:scope="dsx.variable.scope" input:space="dsx.attribute.space" input:vector="dsx.variable.vector">
      if (!q || q.length < 2) { return [] }
      const index = dsx.api.searchIndex.data
      if (!index || !index.pages) { return [] }
      const all = scope === 'All spaces'
      const labels = { modern: 'Modern', legacy: 'Legacy v3', migrate: 'Migration', troubleshooting: 'Troubleshooting', 'app-review': 'App Review', releases: 'Releases', blog: 'Blog' }
      const needle = q.toLowerCase()
      const pool = all ? index.pages : index.pages.filter((page) => page.space === space)
      const inTitle = pool.filter((page) => page.title.toLowerCase().includes(needle))
      const inText = pool.filter((page) => !page.title.toLowerCase().includes(needle) && page.text.toLowerCase().includes(needle))
      const ranked = inTitle.concat(inText).slice(0, 8)
      const seen = ranked.map((page) => page.route)
      const site = 'https://docs.despia.com'
      const related = (vector || []).map((hit) => {
        const url = String(hit.url || '')
        const path = url.startsWith(site) ? (url.slice(site.length) || '/') : url
        return { route: path, title: String(hit.title || path), label: '', space: String(hit.space || ''), section: 'Related', related: true }
      }).filter((hit) => hit.route !== '' && !seen.includes(hit.route)).slice(0, 5)
      const groupName = (page) => {
        if (page.related) { return 'Related' }
        const sec = page.section === '' ? 'Start' : page.section.charAt(0).toUpperCase() + page.section.slice(1)
        return all ? (labels[page.space] || page.space) + ' · ' + sec : sec
      }
      const bySection = ranked.concat(related).groupBy(groupName)
      return Object.entries(bySection).map((pair) => ({
        name: pair[0],
        rows: pair[1].map((page) => ({ id: page.route, title: page.label ? page.label : page.title, route: page.route })),
      }))
    </formula>
    <!-- The panel's state: '' closed · 'prompt' (field active, under two characters) ·
         'results' (grouped hits, or the no-results face when hitGroups is empty). -->
    <formula as="searchState" input:q="dsx.variable.query" input:focus="dsx.variable.searchFocus" input:open="dsx.variable.searchOpen">
      if (q && q.length >= 2) { return 'results' }
      return focus || open ? 'prompt' : ''
    </formula>
    <formula as="tocRows" input:raw="dsx.attribute.toc">
      if (!raw || raw === '') { return [] }
      return JSON.parse(raw)
    </formula>
    <!-- The help menu. Rows with an href are plain links; the hook classes are the actions docs.js
         performs (copy, and the Support widget intents). -->
    <formula as="helpActions">
      return [
        { id: 'copy', title: 'Copy for AI', hint: 'This page as Markdown, ready to paste into any assistant', hook: 'doc-actions-copy' },
        { id: 'ask', title: 'Ask AI', hint: 'An answer from the docs and real projects, in seconds', hook: 'doc-ask-btn-inline' },
        { id: 'human', title: 'Ask a human', hint: 'An engineer reads your question and your project', hook: 'doc-ask-human' },
        { id: 'edit', title: 'Propose an edit', hint: 'Suggest a change to this page and follow it in chat', hook: 'doc-propose-edit' },
        { id: 'feature', title: 'Request a feature', hint: 'Tell us what Despia is missing and follow it in chat', hook: 'doc-request-feature' },
      ]
    </formula>
    <formula as="helpLinks" input:md="dsx.attribute.md" input:prompt="dsx.formula.askPrompt">
      return [
        { id: 'md', title: 'View as Markdown', hint: 'The page source as plain text', href: md },
        { id: 'claude', title: 'Open in Claude', hint: 'Ask Claude about this page', href: 'https://claude.ai/new?q=' + prompt },
        { id: 'chatgpt', title: 'Open in ChatGPT', hint: 'Ask ChatGPT about this page', href: 'https://chatgpt.com/?hints=search&q=' + prompt },
        { id: 'cursor', title: 'Connect to Cursor', hint: 'Install the docs MCP server in Cursor', href: 'cursor://anysphere.cursor-deeplink/mcp/install?name=despia-docs&config=eyJ1cmwiOiJodHRwczovL2RvY3MuZGVzcGlhLmNvbS9tY3AifQ==' },
      ]
    </formula>
    <formula as="improvedRows" input:raw="dsx.attribute.improved">
      if (!raw || raw === '' || raw === '[]') { return [] }
      return JSON.parse(raw)
    </formula>
    <formula as="themeState" input:docs="dsx.global.docs">
      return docs && docs.theme ? docs.theme : ''
    </formula>
    <!-- Open-in links: the assistant reads the page's markdown sibling by URL. -->
    <formula as="askPrompt" input:md="dsx.attribute.md">
      return encodeURIComponent('Read https://docs.despia.com' + md + ' so I can ask questions about it.')
    </formula>
    <action as="cycleTheme">
      const current = dsx.global.docs && dsx.global.docs.theme ? dsx.global.docs.theme : ''
      dsx.global.docs = { theme: current === '' ? 'dark' : current === 'dark' ? 'light' : '' }
    </action>
    <action as="closeSearch">
      dsx.variable.query = ''
      dsx.variable.searchOpen = false
      dsx.variable.searchFocus = false
    </action>
    <action as="toggleSearch">
      if (dsx.variable.searchOpen) { dsx.action.closeSearch() } else { dsx.variable.searchOpen = true }
    </action>
    <action as="closeNav">
      dsx.variable.navOpen = false
    </action>
    <action as="toggleSwitcher">
      dsx.variable.actionsOpen = false
      dsx.variable.switcherOpen = !dsx.variable.switcherOpen
    </action>
    <action as="toggleActions">
      dsx.variable.switcherOpen = false
      dsx.variable.actionsOpen = !dsx.variable.actionsOpen
    </action>
    <!-- Vector hits are progressive: the keyword list is already on screen; the Support
         knowledge API answers within a debounce and its hits merge in. Offline, refused or
         slow, the list simply stays keyword-only (no error face, by design). -->
    <action as="queueVector">
      dsx.variable.vector = []
      const q = dsx.variable.query
      if (!q || q.length < 3 || dsx.attribute.supportOrigin === '') { return }
      setTimeout(() => { dsx.action.fetchVector() }, 300, 'docs-vector')
    </action>
    <action as="fetchVector">
      const q = dsx.variable.query
      if (!q || q.length < 3) { return }
      const space = dsx.variable.scope === 'All spaces' ? 'all' : dsx.attribute.space
      const r = await fetch(dsx.attribute.supportOrigin + '/v1/search?q=' + encodeURIComponent(q) + '&space=' + space + '&limit=6')
      if (r.ok && r.data && r.data.hits && dsx.variable.query === q) { dsx.variable.vector = r.data.hits }
    </action>
    <watch value="dsx.variable.query" on:change="dsx.action.queueVector()"/>
    <watch value="dsx.variable.scope" on:change="dsx.action.queueVector()"/>
  </head>

  <stack class="doc-header">
    <hstack class="doc-header-row">
      <pressable class="doc-icon-btn doc-nav-toggle" a11yLabel="Open navigation"
                 on:tap="dsx.variable.navOpen = true">
        <svg style="width: 18px; height: 18px" d="M3 6.4h18v1.6H3z M3 11.2h18v1.6H3z M3 16h18v1.6H3z" viewBox="0 0 24 24" fill="currentColor"/>
      </pressable>
      <pressable href="/" class="doc-wordmark" a11yLabel="Despia documentation home">
        <text value="Despia" class="doc-wordmark-name"/>
        <text value="Docs" class="doc-wordmark-tag"/>
      </pressable>
      <popover present="dsx.variable.switcherOpen" on:dismiss="dsx.variable.switcherOpen = false" arrow="top" class="doc-switcher">
        <button label="{{ dsx.formula.spaceLabel }}" icon="chevron.down" variant="bordered" class="doc-switcher-btn"
                on:tap="dsx.action.toggleSwitcher()" a11yLabel="{{ 'Documentation space: ' + dsx.formula.spaceLabel + '. Activate to switch.' }}"/>
        <stack slot="content" class="doc-switcher-panel" role="navigation" a11yLabel="Documentation spaces">
          <scroll class="doc-switcher-scroll">
          <list bind="dsx.formula.spaceRows" key="id" scroll="false" class="doc-switcher-list">
            <row href="{{ dsx.this.home }}" on:tap="dsx.variable.switcherOpen = false">
              <hstack class="doc-switcher-row">
                <stack class="doc-switcher-copy">
                  <text value="{{ dsx.this.label }}" class="doc-switcher-name"/>
                  <text value="{{ dsx.this.blurb }}" class="doc-switcher-blurb"/>
                </stack>
                <image icon="checkmark" iconSize="14" visible-if="dsx.this.current" a11yHidden="true" style="color: var(--dsx-accent)"/>
              </hstack>
            </row>
          </list>
          </scroll>
        </stack>
      </popover>
      <chip label="{{ 'v' + dsx.attribute.version }}" class="doc-version-chip"/>
      <spacer/>
      <stack class="doc-search-inline">
        <searchbar bind="dsx.variable.query" placeholder="{{ 'Search ' + dsx.formula.spaceLabel }}"
                   on:focus="dsx.variable.searchFocus = true" on:blur="dsx.variable.searchFocus = false"/>
        <text value="&#8984;K" class="doc-kbd" a11yHidden="true" visible-if="dsx.variable.query === ''"/>
      </stack>
      <pressable class="doc-icon-btn doc-search-toggle" a11yLabel="Search"
                 on:tap="dsx.action.toggleSearch()">
        <svg style="width: 18px; height: 18px" d="M10.5 3c4.142 0 7.5 3.358 7.5 7.5s-3.358 7.5-7.5 7.5S3 14.642 3 10.5 6.358 3 10.5 3zm0 2c-3.038 0-5.5 2.462-5.5 5.5s2.462 5.5 5.5 5.5 5.5-2.462 5.5-5.5S13.538 5 10.5 5zm4.94 11.85l4.66 4.65 1.4-1.4-4.65-4.66-1.41 1.41z" viewBox="0 0 24 24" fill="currentColor"/>
      </pressable>
      <!-- Ask AI: the Despia Support widget in docs mode. docs.js loads the widget script on
           the first tap (never before) and mounts <despia-support mode="docs">; when the
           script is unreachable the button stays inert. -->
      <button label="Ask AI" icon="sparkles" variant="bordered" class="doc-ask-btn" a11yLabel="Ask AI about the docs"/>
      <pressable href="https://github.com/despia-native/despia" class="doc-icon-btn doc-github" a11yLabel="Despia on GitHub">
        <svg style="width: 18px; height: 18px" d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.27-.01-1.17-.02-2.12-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.02 1.75 2.68 1.25 3.34.95.1-.74.4-1.25.72-1.54-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18.92-.26 1.9-.38 2.88-.39.98.01 1.96.13 2.88.39 2.2-1.49 3.16-1.18 3.16-1.18.63 1.59.24 2.76.12 3.05.74.81 1.18 1.83 1.18 3.09 0 4.41-2.69 5.38-5.25 5.67.41.35.78 1.05.78 2.12 0 1.53-.01 2.76-.01 3.14 0 .3.21.67.8.55C20.44 21.37 23.5 17.06 23.5 12 23.5 5.65 18.35.5 12 .5z" viewBox="0 0 24 24" fill="currentColor"/>
      </pressable>
      <pressable class="doc-icon-btn" on:tap="dsx.action.cycleTheme()"
                 a11yLabel="{{ 'Color scheme: ' + (dsx.formula.themeState === '' ? 'system' : dsx.formula.themeState) + '. Activate to change.' }}">
        <svg style="width: 18px; height: 18px" visible-if="dsx.formula.themeState === ''" d="M12 2c5.523 0 10 4.477 10 10s-4.477 10-10 10S2 17.523 2 12 6.477 2 12 2zm0 2.5v15c4.142 0 7.5-3.358 7.5-7.5S16.142 4.5 12 4.5z" viewBox="0 0 24 24" fill="currentColor"/>
        <svg style="width: 18px; height: 18px" visible-if="dsx.formula.themeState === 'dark'" d="M20.74 13.15c-1.06.3-2.18.47-3.34.47-6.02 0-10.9-4.88-10.9-10.9 0-.62.05-1.23.15-1.82C3.15 2.28 1 5.9 1 10c0 5.52 4.48 10 10 10 4.61 0 8.5-3.12 9.74-6.85z" viewBox="0 0 24 24" fill="currentColor"/>
        <svg style="width: 18px; height: 18px" visible-if="dsx.formula.themeState === 'light'" d="M12 7c2.761 0 5 2.239 5 5s-2.239 5-5 5-5-2.239-5-5 2.239-5 5-5zm-.8-5h1.6v3h-1.6zm0 17h1.6v3h-1.6zM2 11.2h3v1.6H2zm17 0h3v1.6h-3zM4.9 6.03l1.13-1.13 2.12 2.12-1.13 1.13zm10.95 10.97l1.13-1.13 2.12 2.12-1.13 1.13zM4.9 17.97l2.12-2.12 1.13 1.13-2.12 2.12zm10.95-10.95l2.12-2.12 1.13 1.13-2.12 2.12z" viewBox="0 0 24 24" fill="currentColor"/>
      </pressable>
    </hstack>
    <stack class="doc-search-row" visible-if="dsx.variable.searchOpen">
      <searchbar bind="dsx.variable.query" placeholder="{{ 'Search ' + dsx.formula.spaceLabel }}"
                 on:focus="dsx.variable.searchFocus = true" on:blur="dsx.variable.searchFocus = false"/>
    </stack>
    <!-- The results panel: an elevated overlay surface under the header. The scope control
         leads (this space or every space), then one of three faces rides searchState. -->
    <stack class="doc-search-panel" visible-if="dsx.formula.searchState !== ''" role="navigation" a11yLabel="Search results">
      <hstack class="doc-search-scope">
        <segmented bind="dsx.variable.scope" options="This space,All spaces" label="Search scope"/>
      </hstack>
      <stack class="doc-search-blank" visible-if="dsx.formula.searchState === 'prompt'">
        <image style="color: var(--dsx-secondary-label)" icon="magnifyingglass" iconSize="32" a11yHidden="true" class="doc-search-blank-icon"/>
        <stack class="doc-search-blank-copy" a11yGroup="true">
          <text style="text-align: center" value="{{ 'Search ' + (dsx.variable.scope === 'All spaces' ? 'all the docs' : dsx.formula.spaceLabel) }}" class="doc-search-blank-title"/>
          <text style="text-align: center" value="Type at least two characters to find a page." class="doc-search-blank-hint"/>
        </stack>
      </stack>
      <stack class="doc-search-blank" visible-if="dsx.formula.searchState === 'results' &amp;&amp; dsx.formula.hitGroups.length === 0">
        <image style="color: var(--dsx-secondary-label)" icon="tray" iconSize="32" a11yHidden="true" class="doc-search-blank-icon"/>
        <stack class="doc-search-blank-copy" a11yGroup="true">
          <text style="text-align: center" value="No results" class="doc-search-blank-title"/>
          <text style="text-align: center" value="{{ 'Nothing matches “' + dsx.variable.query + '”' + (dsx.variable.scope === 'All spaces' ? '.' : ' here. Try All spaces.') }}" class="doc-search-blank-hint"/>
        </stack>
      </stack>
      <scroll class="doc-hit-scroll" visible-if="dsx.formula.hitGroups.length > 0">
        <list style="gap: 0px" bind="dsx.formula.hitGroups" key="name" scroll="false" class="doc-hit-groups">
          <stack class="doc-hit-group">
            <text value="{{ dsx.this.name }}" class="doc-hit-label"/>
            <list style="gap: 0px" bind="dsx.this.rows" key="id" scroll="false" class="doc-hit-list">
              <row href="{{ dsx.this.route }}" on:tap="dsx.action.closeSearch()">
                <hstack class="doc-hit">
                  <text value="{{ dsx.this.title }}" class="doc-hit-title"/>
                </hstack>
              </row>
            </list>
          </stack>
        </list>
      </scroll>
    </stack>
  </stack>

  <hstack class="doc-frame">
    <stack class="doc-sidebar">
      <DocNav route="{{ dsx.attribute.route }}" space="{{ dsx.attribute.space }}" on:navigate="dsx.action.closeNav()"/>
    </stack>
    <Drawer class="doc-drawer" present="dsx.variable.navOpen" on:close="dsx.variable.navOpen = false"
            a11yLabel="Documentation navigation">
      <DocNav route="{{ dsx.attribute.route }}" space="{{ dsx.attribute.space }}" on:navigate="dsx.action.closeNav()"/>
    </Drawer>

    <stack class="doc-main{{ dsx.attribute.route === '/' ? ' doc-main-home' : '' }}">
      <stack class="doc-column">
        <hstack class="doc-crumbs" role="navigation" a11yLabel="Breadcrumb" visible-if="dsx.attribute.route !== '/'">
          <pressable href="{{ dsx.formula.spaceHome }}" class="doc-crumb-link"><text value="{{ dsx.attribute.space === 'modern' ? 'Docs' : dsx.formula.spaceLabel }}" class="doc-crumb"/></pressable>
          <image style="color: var(--dsx-tertiary-label)" icon="chevron.right" iconSize="10" a11yHidden="true" visible-if="dsx.attribute.section !== ''"/>
          <text value="{{ dsx.attribute.section }}" class="doc-crumb" visible-if="dsx.attribute.section !== ''"/>
          <image style="color: var(--dsx-tertiary-label)" icon="chevron.right" iconSize="10" a11yHidden="true"/>
          <text value="{{ dsx.attribute.label !== '' ? dsx.attribute.label : dsx.attribute.title }}" class="doc-crumb-current"/>
        </hstack>

        <!-- The help bar (PLAN-K K1): Copy for AI, Open in Claude / ChatGPT / Cursor, Ask AI, Ask a
             human, plus Propose an edit and Request a feature. Sticky under the header on wide
             frames; under 40rem it folds into one Help button whose menu opens as a bottom
             sheet. Copy and the Open-in links work without the Support widget; the widget rows
             load it lazily (docs.js) and stay inert when it is unreachable. -->
        <hstack class="doc-helpbar" visible-if="dsx.attribute.md !== ''" role="toolbar" a11yLabel="Page help">
          <button label="Copy for AI" icon="doc.on.doc" variant="bordered" class="doc-actions-copy doc-help-wide"/>
          <button label="Open in Claude" variant="bordered" href="{{ 'https://claude.ai/new?q=' + dsx.formula.askPrompt }}" class="doc-help-wide"/>
          <button label="Ask AI" icon="sparkles" variant="bordered" class="doc-ask-btn-inline doc-help-wide"/>
          <button label="Ask a human" icon="person" variant="bordered" class="doc-ask-human doc-help-wide"/>
          <spacer/>
          <popover present="dsx.variable.actionsOpen" on:dismiss="dsx.variable.actionsOpen = false" arrow="top" class="doc-actions">
            <button label="More" icon="ellipsis" variant="plain" class="doc-actions-more" on:tap="dsx.action.toggleActions()" a11yLabel="More ways to get help with this page"/>
            <stack slot="content" class="doc-actions-menu" role="menu" a11yLabel="Page help">
              <scroll class="doc-actions-scroll">
                <list bind="dsx.formula.helpActions" key="id" scroll="false" class="doc-actions-list">
                  <row on:tap="dsx.variable.actionsOpen = false">
                    <stack class="doc-actions-row {{ dsx.this.hook }}">
                      <text value="{{ dsx.this.title }}" class="doc-actions-row-title"/>
                      <text value="{{ dsx.this.hint }}" class="doc-actions-row-hint"/>
                    </stack>
                  </row>
                </list>
                <list bind="dsx.formula.helpLinks" key="id" scroll="false" class="doc-actions-list">
                  <row href="{{ dsx.this.href }}" on:tap="dsx.variable.actionsOpen = false">
                    <stack class="doc-actions-row">
                      <text value="{{ dsx.this.title }}" class="doc-actions-row-title"/>
                      <text value="{{ dsx.this.hint }}" class="doc-actions-row-hint"/>
                    </stack>
                  </row>
                </list>
              </scroll>
            </stack>
          </popover>
        </hstack>

        <hstack class="doc-version-badges" visible-if="dsx.attribute.since !== '' || dsx.attribute.changed !== '' || dsx.attribute.removed !== '' || dsx.formula.improvedRows.length > 0">
          <chip label="{{ 'Added in ' + dsx.attribute.since }}" visible-if="dsx.attribute.since !== ''"/>
          <chip label="{{ 'Changed in ' + dsx.attribute.changed }}" visible-if="dsx.attribute.changed !== ''"/>
          <chip label="{{ 'Removed in ' + dsx.attribute.removed }}" role="destructive" visible-if="dsx.attribute.removed !== ''"/>
          <scroll class="doc-vbadge-scroll" visible-if="dsx.formula.improvedRows.length > 0">
            <list bind="dsx.formula.improvedRows" key="id" scroll="false" class="doc-vbadge-list">
              <button label="{{ 'Improved in ' + dsx.this.version + ': ' + dsx.this.title }}" variant="plain" href="{{ dsx.this.url }}"/>
            </list>
          </scroll>
        </hstack>

        <stack class="doc-legacy-banner" visible-if="dsx.attribute.space === 'legacy'">
          <Banner type="info" title="Legacy docs (Despia v3)" message="This page documents despia-native on the v3 runtime."/>
          <button label="{{ dsx.attribute.modern !== '' ? 'Modern equivalent' : 'Migration map' }}" icon="arrow.right" variant="plain"
                  href="{{ dsx.attribute.modern !== '' ? dsx.attribute.modern : '/migrate/map' }}" class="doc-legacy-link"/>
        </stack>

        <slot/>

        <hstack class="doc-pager" visible-if="dsx.attribute.prev !== '' || dsx.attribute.next !== ''">
          <pressable href="{{ dsx.attribute.prev }}" class="doc-pager-card doc-pager-prev" visible-if="dsx.attribute.prev !== ''">
            <text value="Previous" class="doc-pager-eyebrow"/>
            <text value="{{ dsx.attribute.prevLabel }}" class="doc-pager-title"/>
          </pressable>
          <spacer/>
          <pressable href="{{ dsx.attribute.next }}" class="doc-pager-card doc-pager-next" visible-if="dsx.attribute.next !== ''">
            <text value="Next" class="doc-pager-eyebrow"/>
            <text value="{{ dsx.attribute.nextLabel }}" class="doc-pager-title"/>
          </pressable>
        </hstack>

        <text value="Apache-2.0. Every page has a markdown sibling at its own path plus .md; each space is one llms.txt away."
              class="doc-footer"/>
      </stack>

      <stack class="doc-rail" visible-if="dsx.formula.tocRows.length >= 2" role="navigation" a11yLabel="On this page">
        <text value="On this page" class="doc-rail-label"/>
        <scroll class="doc-toc-scroll">
          <list bind="dsx.formula.tocRows" key="id" scroll="false" class="doc-toc">
            <row href="#{{ dsx.this.id }}">
              <text value="{{ dsx.this.title }}" class="doc-toc-text doc-toc-l{{ dsx.this.level }}"/>
            </row>
          </list>
        </scroll>
      </stack>
    </stack>
  </hstack>
</stack>
