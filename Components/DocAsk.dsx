<!-- DocAsk: Ask AI over the Despia docs, a self-contained panel that drops into any shell (a side panel on a wide window,
     a sheet on a phone; the host only places it):

       <DocAsk space="{{ dsx.attribute.space }}" on:open="..."/>

     It owns its state and its one request: POST /api/ask (worker/ask.ts) streams a grounded answer as Server-Sent
     Events. The answer cites the docs sections it used as [n]; each one is a link, and the sources are rows under it.
     States, all stock console UI: the empty state with suggestion rows, searching, the streaming answer (the stock
     Answer block), sources, copy answer, "I could not find this" with the closest pages, AI paused (the spend guard or
     the docs switch: the matching pages instead of an answer), busy, rate limited, and errors with Try again.
     Without an AI key the Worker answers with the labelled stub model, so retrieval and citations still show.
     `open` is raised with { route, url } when a source row is tapped (the panel also routes to it). -->
<vstack class="doc-ask">
  <head>
    <attribute as="space" default="'all'"/>
    <attribute as="endpoint" default="'/api/ask'"/>
    <event as="open"/>

    <api as="ask" ssr="false" method="POST" stream="true" url="{{ dsx.attribute.endpoint }}" timeout="45000"
         on:message="dsx.action.take({ chunk: dsx.this.data })"
         on:success="dsx.action.finished()"
         on:error="dsx.action.failed({ error: dsx.this.error })"/>

    <variable as="draft">return ''</variable>
    <variable as="question">return ''</variable>
    <!-- idle · asking · streaming · done · paused · error -->
    <variable as="phase">return 'idle'</variable>
    <variable as="chunks">return []</variable>
    <variable as="failure">return null</variable>

    <!-- the suggestion rows: objects with an id and a label, never bare strings (the old panel bound strings and
         painted "[object Object]") -->
    <variable as="suggestions" computed="true">
      return [
        { id: 's1', label: 'How do I add a native screen to my web app?' },
        { id: 's2', label: 'How do I send a push notification?' },
        { id: 's3', label: 'How do I move my V3 app to V4?' },
        { id: 's4', label: 'How do I play a haptic when a button is tapped?' }
      ]
    </variable>

    <variable as="meta" computed="true">
      const m = dsx.variable.chunks.find((c) =&gt; c != null &amp;&amp; c.type === 'meta')
      return m == null ? { mode: '', model: '', sources: [], related: [] } : m
    </variable>
    <variable as="answerText" computed="true">
      return dsx.variable.chunks.filter((c) =&gt; c != null &amp;&amp; c.type === 'delta').map((c) =&gt; String(c.text)).join('')
    </variable>
    <!-- [n] becomes a link to the section it cites, on this site (a relative path, so it works on every host);
         a bracket inside a code fence is left alone; a number with no source is dropped -->
    <variable as="answerMarkdown" computed="true">
      const sources = dsx.variable.meta.sources || []
      const pathOf = (n) =&gt; { const s = sources.find((x) =&gt; x.n === n); return s == null ? '' : linkPath(s.url) }
      return dsx.variable.answerText.split(/(```[\s\S]*?(?:```|$))/g).map((part, i) =&gt; {
        if (i % 2 === 1) { return part }
        return part.replace(/\[([0-9][0-9, ]*)\]/g, (m, list, at, whole) =&gt; whole.charAt(at + m.length) === '(' ? m : list.split(',')
          .map((x) =&gt; Number(x.trim())).filter((n) =&gt; pathOf(n) !== '').map((n) =&gt; '[[' + n + '](' + pathOf(n) + ')]').join(''))
      }).join('')
    </variable>
    <variable as="sourceRows" computed="true">
      return (dsx.variable.meta.sources || []).map((s) =&gt; ({
        id: 'src' + s.n, title: String(s.n) + '. ' + String(s.title), subtitle: String(s.heading || ''), route: String(s.route), url: String(s.url)
      }))
    </variable>
    <!-- the closest pages (a refusal) or the matching pages (AI paused, busy, failed): the page list fallback -->
    <variable as="pageRows" computed="true">
      const f = dsx.variable.failure
      const list = f != null &amp;&amp; Array.isArray(f.pages) ? f.pages : (dsx.variable.meta.related || [])
      return list.map((p, i) =&gt; ({ id: 'page' + i, title: String(p.title), subtitle: linkPath(p.url), route: String(p.route), url: String(p.url) }))
    </variable>
    <variable as="busy" computed="true">return dsx.variable.phase === 'asking' || dsx.variable.phase === 'streaming'</variable>
    <variable as="refused" computed="true">return dsx.variable.meta.mode === 'refusal'</variable>
    <variable as="footnote" computed="true">
      const mode = dsx.variable.meta.mode
      if (mode === 'stub') { return 'Stub model: no AI key is set on this deployment. The passages and citations are real.' }
      if (mode === 'model') { return 'Written by AI from the Despia docs. Check the sources.' }
      return ''
    </variable>
    <variable as="failureTitle" computed="true">
      const f = dsx.variable.failure
      if (f == null) { return '' }
      if (f.code === 'ai_paused') { return 'AI answers are paused' }
      if (f.code === 'ai_busy') { return 'Ask AI is busy' }
      if (f.code === 'rate_limited') { return 'Too many questions' }
      if (f.code === 'timeout') { return 'That took too long' }
      return 'No answer this time'
    </variable>
    <variable as="failureTone" computed="true">
      const f = dsx.variable.failure
      return f != null &amp;&amp; (f.code === 'ai_paused' || f.code === 'ai_busy') ? 'info' : (f != null &amp;&amp; f.code === 'rate_limited' ? 'warning' : 'error')
    </variable>

    <action as="send" input:text="dsx.this.text">
      const q = String(text == null ? dsx.variable.draft : text).trim()
      if (q === '' || dsx.variable.busy) { return }
      dsx.variable.draft = ''
      dsx.variable.question = q
      dsx.variable.chunks = []
      dsx.variable.failure = null
      dsx.variable.phase = 'asking'
      dsx.api.ask({ question: q, space: dsx.attribute.space })
    </action>
    <action as="suggest" input:label="dsx.this.label">
      dsx.action.send({ text: label })
    </action>
    <action as="retry">
      const q = dsx.variable.question
      if (q !== '') { dsx.action.send({ text: q }) }
    </action>
    <action as="take" input:chunk="dsx.this.chunk">
      if (chunk == null || typeof chunk !== 'object') { return }
      dsx.variable.chunks = dsx.variable.chunks.concat([chunk])
      if (chunk.type === 'meta' || chunk.type === 'delta') { dsx.variable.phase = 'streaming' }
      if (chunk.type === 'done') { dsx.variable.phase = 'done' }
    </action>
    <action as="finished">
      if (dsx.variable.phase !== 'paused' &amp;&amp; dsx.variable.phase !== 'error') { dsx.variable.phase = 'done' }
    </action>
    <action as="failed" input:error="dsx.this.error">
      const body = error != null &amp;&amp; error.body != null &amp;&amp; typeof error.body === 'object' ? error.body : {}
      const code = String(body.error || body.code || (error != null &amp;&amp; error.status === 0 ? 'network' : 'upstream_unavailable'))
      const message = String(body.message || (code === 'network' ? 'Could not reach the docs server. Check your connection and try again.' : 'Something went wrong. Try again in a moment.'))
      dsx.variable.failure = { code: code, message: message, pages: Array.isArray(body.pages) ? body.pages : null }
      dsx.variable.phase = code === 'ai_paused' || code === 'ai_busy' ? 'paused' : 'error'
    </action>
    <action as="stop">
      dsx.api.ask.cancel()
      dsx.variable.phase = 'done'
    </action>
    <action as="openRow" input:route="dsx.this.route" input:url="dsx.this.url">
      dsx.event('open', { route: route, url: url })
      dsx.module.route.select({ path: route })
    </action>
    <action as="startOver">
      dsx.variable.question = ''
      dsx.variable.chunks = []
      dsx.variable.failure = null
      dsx.variable.phase = 'idle'
    </action>

    <script>
      // a docs URL as a path on this site (/packages/haptic#install), so links stay on the host serving the panel
      function linkPath(url) {
        const u = String(url == null ? '' : url)
        const m = /^https:\/\/docs\.despia\.com(\/[^\s]*)?$/.exec(u)
        return m == null ? u : (m[1] == null || m[1] === '' ? '/' : m[1])
      }
    </script>
  </head>

  <vstack class="doc-ask-content">
      <!-- empty -->
      <EmptyState icon="sparkles" title="Ask the Despia docs" message="Answers come from this documentation, with a link to every section they use."
                  visible-if="dsx.variable.phase === 'idle'"/>
      <ListGroup header="Try asking" visible-if="dsx.variable.phase === 'idle'">
        <SettingsRow repeat="dsx.variable.suggestions" key="id" icon="sparkles" title="{{ dsx.this.label }}" tappable="true"
                     on:tap="dsx.action.suggest({ label: dsx.this.label })"/>
      </ListGroup>

      <!-- the question and its answer -->
      <hstack class="doc-ask-question-row" visible-if="dsx.variable.phase !== 'idle'">
        <text class="doc-ask-question" type="headline" value="{{ dsx.variable.question }}"/>
        <spacer/>
        <button icon="square.and.pencil" variant="plain" a11yLabel="New question" visible-if="!dsx.variable.busy" on:tap="dsx.action.startOver()"/>
      </hstack>
      <ThinkingOrb label="Searching the docs" visible-if="dsx.variable.phase === 'asking'"/>
      <Answer text="{{ dsx.variable.answerMarkdown }}" streaming="{{ dsx.variable.phase === 'streaming' }}"
              visible-if="dsx.variable.answerText !== ''" a11yLabel="Answer"/>
      <hstack class="doc-ask-answer-actions" visible-if="dsx.variable.phase === 'done' &amp;&amp; dsx.variable.answerText !== '' &amp;&amp; !dsx.variable.refused">
        <CopyButton value="{{ dsx.variable.answerText }}" label="Copy answer"/>
        <text type="caption" class="doc-ask-footnote" value="{{ dsx.variable.footnote }}"/>
      </hstack>
      <ListGroup header="Sources" visible-if="dsx.variable.sourceRows.length &gt; 0">
        <SettingsRow repeat="dsx.variable.sourceRows" key="id" icon="doc.text" title="{{ dsx.this.title }}" subtitle="{{ dsx.this.subtitle }}"
                     chevron="true" tappable="true" on:tap="dsx.action.openRow({ route: dsx.this.route, url: dsx.this.url })"/>
      </ListGroup>

      <!-- AI paused, busy, rate limited or failed: say so, then the pages that match -->
      <Callout tone="{{ dsx.variable.failureTone }}" title="{{ dsx.variable.failureTitle }}"
               message="{{ dsx.variable.failure == null ? '' : dsx.variable.failure.message }}"
               action="{{ dsx.variable.phase === 'error' ? 'Try again' : '' }}" on:action="dsx.action.retry()"
               visible-if="dsx.variable.failure != null"/>
      <ListGroup header="{{ dsx.variable.refused ? 'Closest pages' : 'Pages that match' }}"
                 visible-if="dsx.variable.pageRows.length &gt; 0 &amp;&amp; (dsx.variable.refused || dsx.variable.failure != null)">
        <SettingsRow repeat="dsx.variable.pageRows" key="id" icon="doc.text" title="{{ dsx.this.title }}" subtitle="{{ dsx.this.subtitle }}"
                     chevron="true" tappable="true" on:tap="dsx.action.openRow({ route: dsx.this.route, url: dsx.this.url })"/>
      </ListGroup>
  </vstack>

  <PromptInput value="{{ dsx.variable.draft }}" placeholder="Ask a question about Despia" attach="false" enterSends="true" maxLines="4"
               max="500" busy="{{ dsx.variable.busy }}" a11yLabel="Ask the Despia docs"
               on:change="dsx.variable.draft = dsx.this.text" on:submit="dsx.action.send({ text: dsx.this.text })" on:stop="dsx.action.stop()"/>
</vstack>
