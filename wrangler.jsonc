// The docs site's deploy manifest: `npm run build` first (compile → dsx build → assemble),
// then `npx wrangler deploy`. `--dry-run` validates without an account — the CI gate.
// The worker runs first (run_worker_first): it owns the redirects (/mcp 301s to mcp.despia.com) and SSR for dynamic routes, and
// reaches the static tree through the ASSETS binding — the same chain the framework's own
// site face implements.
{
  "name": "despia-docs",
  "main": "worker/index.ts",
  "compatibility_date": "2025-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    // /x serves /x/index.html in place (200, no redirect) and /x/ 307s to /x: every old URL's
    // one 301 lands on a 200 (scripts/setup-parity.mjs holds that for all 189 v3 pages)
    "html_handling": "drop-trailing-slash"
  },
  "observability": { "enabled": true },
  // A private preview: its own worker on workers.dev, never a despia.com route, noindex everywhere.
  // `npx wrangler deploy --env preview`
  "env": {
    "preview": {
      "name": "despia-docs-preview",
      "vars": { "NOINDEX": "1" },
      "workers_dev": true,
      "routes": []
    }
  }
}
