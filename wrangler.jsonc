// The docs site's deploy manifest: `npm run build` first (compile → dsx build → assemble),
// then `npx wrangler deploy`. `--dry-run` validates without an account — the CI gate.
// The worker runs first (run_worker_first): it owns /mcp and SSR for dynamic routes, and
// reaches the static tree through the ASSETS binding — the same chain the framework's own
// site face implements.
{
  "name": "despia-docs",
  "main": "worker/index.ts",
  "compatibility_date": "2025-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    // /x serves /x/index.html in place (200, no redirect) and /x/ 307s to /x: every old URL's
    // one 301 lands on a 200 (scripts/setup-parity.mjs holds that for all 189 v3 pages)
    "html_handling": "drop-trailing-slash"
  },
  "observability": { "enabled": true },
  // Ask AI (worker/ask.ts). The account spend guard is read over this service binding before any model call; without it
  // (or when it does not answer) AI answers stay paused: fail closed. Deploy despia-spend-guard first.
  // Secret (never in this file): `npx wrangler secret put OPENROUTER_API_KEY`, the docs' own OpenRouter key, same
  // provider and model as the API's Support AI. Optional vars: DOCS_AI_MODEL (default anthropic/claude-sonnet-4.5),
  // DOCS_AI_PAUSED=1 (manual switch), DOCS_ASK_ORIGINS (extra origins allowed to call /api/ask).
  "services": [{ "binding": "SPEND_GUARD", "service": "despia-spend-guard" }],
  // A private preview: its own worker on workers.dev, never a despia.com route, noindex everywhere.
  // `npx wrangler deploy --env preview`
  "env": {
    "preview": {
      "name": "despia-docs-preview",
      "vars": { "NOINDEX": "1" },
      "workers_dev": true,
      "routes": [],
      "services": [{ "binding": "SPEND_GUARD", "service": "despia-spend-guard" }]
    }
  }
}
